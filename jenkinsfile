
pipeline{
    agent {
        label 'docker'
    }
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t alan0o0s/react-test -f Dockerfile.dev .'
                }
            }
        }
        stage('Run Tests'){
            steps {
                script {
                    env.DOCKER_BUILDKIT = 1
                    sh 'docker run -e CI=true alan0o0s/react-test npm run test'
                }
            }
        }
    }
}
